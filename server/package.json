{
  "name": "music-streaming-server",
  "version": "1.0.0",
  "description": "RESTful API Backend with Express and MongoDB for Music Streaming App",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed/seedData.js",
    "hash-passwords": "node src/seed/hashPasswords.js",
    "test": "jest",
    "test:unit": "jest tests/unit --verbose",
    "test:integration": "jest tests/integration --runInBand --verbose",
    "test:e2e": "node tests/e2e/app-api.e2e.mjs"
  },
  "dependencies": {
    "@distube/ytdl-core": "^5.2.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "play-dl": "^1.9.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/config/plans.js",
      "src/middleware/**/*.js"
    ]
  }
}
